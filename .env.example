# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Configuration
# Supported: gemini, openai, groq
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1

# Risk Engine Policy Thresholds
APPROVAL_THRESHOLD=500000.00
SPLIT_WINDOW_HOURS=72
BANK_CHANGE_LOOKBACK_DAYS=30
PRICE_DEVIATION_MEDIUM_THRESHOLD=0.25
PRICE_DEVIATION_HIGH_THRESHOLD=0.40

# Server
PORT=8000
HOST=0.0.0.0
