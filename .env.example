# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Configuration
# PRIMARY: Groq, FALLBACK: Gemini
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=1

# Risk Engine Policy Thresholds
APPROVAL_THRESHOLD=500000.00
SPLIT_WINDOW_HOURS=72
BANK_CHANGE_LOOKBACK_DAYS=30
PRICE_DEVIATION_MEDIUM_THRESHOLD=0.25
PRICE_DEVIATION_HIGH_THRESHOLD=0.40

# Server
PORT=8000
HOST=0.0.0.0
